# Paper Trading Project environment variables
PAPER_TRADING_APP_NAME=Paper Trading Project
PAPER_TRADING_ENVIRONMENT=development
PAPER_TRADING_DEBUG=true
PAPER_TRADING_VERSION=0.1.0

# Azure OpenAI (required for LLM agents)
PAPER_TRADING_AZURE_OPENAI_ENDPOINT=https://hkust.azure-api.net/
PAPER_TRADING_AZURE_OPENAI_API_KEY=your-azure-key-here
PAPER_TRADING_AZURE_OPENAI_API_VERSION=2025-02-01-preview
PAPER_TRADING_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Alpaca Paper Trading (required for live trading)
PAPER_TRADING_ALPACA_API_KEY=your-alpaca-key-here
PAPER_TRADING_ALPACA_SECRET_KEY=your-alpaca-secret-here
PAPER_TRADING_ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading parameters
PAPER_TRADING_LOOKBACK_DAYS=20
PAPER_TRADING_BACKTEST_START=2022-01-01
PAPER_TRADING_INITIAL_CAPITAL=100000
PAPER_TRADING_TAKE_PROFIT_PCT=0.15
PAPER_TRADING_STOP_LOSS_PCT=0.08
PAPER_TRADING_RISK_FREE_RATE=0.04

# Default portfolio tickers (comma-separated)
PAPER_TRADING_PORTFOLIO_TICKERS=AAPL,MSFT,JPM,JNJ,XOM,AMZN,NVDA,UNH,BAC,PG
